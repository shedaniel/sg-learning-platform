# Database. Leave everything unset to use the local file ./data/sg.db.

# Remote Turso database (production):
# SG_DB_URL=libsql://your-database-your-org.turso.io
# SG_DB_AUTH_TOKEN=

# Turso's own variable names are also accepted:
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Or an explicit local file:
# SG_DB_URL=file:./data/sg.db
# SG_DB_PATH=./data/sg.db
